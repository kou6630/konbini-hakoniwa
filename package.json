{
  "name": "konbini-hakoniwa",
  "productName": "コンビニはじめちゃいました",
  "version": "1.3.0",
  "description": "3D箱庭コンビニシミュレーション「コンビニはじめちゃいました」",
  "main": "main.js",
  "scripts": {
    "build:js": "esbuild src/main.js --bundle --minify --outfile=dist/game.js",
    "start": "npm run build:js && electron .",
    "pack": "npm run build:js && electron-packager . KonbiniSim --platform=win32 --arch=x64 --out=release --overwrite --ignore=\"^/(release|src|\\.claude|build|scripts)\"",
    "dist": "npm run build:js && electron-builder --win --publish never",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "three": "^0.186.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "author": "kou6630",
  "homepage": "https://github.com/kou6630/konbini-hakoniwa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kou6630/konbini-hakoniwa.git"
  },
  "build": {
    "appId": "com.kou6630.konbini-hakoniwa",
    "productName": "コンビニはじめちゃいました",
    "copyright": "kou6630",
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "dist/game.js",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "KonbiniHakoniwa-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "コンビニはじめちゃいました",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "kou6630",
        "repo": "konbini-hakoniwa",
        "releaseType": "release"
      }
    ]
  }
}
